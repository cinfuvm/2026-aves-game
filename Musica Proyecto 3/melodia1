local step = 1
local speed = 10 -- Slower tempo (~70 BPM)

init_audio()

function update_music()
  if tick % speed == 0 then
    local k = ch_keys[step]
    if k ~= _ then sfx(0, k, 36, 0, 9, 0) end

    local b = ch_bass[step]
    if b ~= _ then sfx(1, b, 36, 1, 13, 0) end

    local l = ch_lead[step]
    if l ~= _ then sfx(2, l, 52, 2, 12, 0) end

    local d = ch_drums[step]
    if d == 1 then sfx(3, 34, 14, 3, 13, 0)
    elseif d == 2 then sfx(4, 58, 12, 3, 9, 0)
    elseif d == 3 then sfx(5, 82, 6, 3, 4, 0)
    end

    step = (step % #ch_keys) + 1
  end
  tick = tick + 1
end

function TIC()
  update_music()
end