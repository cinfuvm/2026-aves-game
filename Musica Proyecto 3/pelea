local tick = 0
local step = 1
local speed = 6
local loop_start = 33

init_audio()

function update_music()
  if tick % speed == 0 then
    local b = ch_bass[step]
    if b ~= _ then sfx(0, b, 12, 0, 15, 0) end

    local l = ch_lead[step]
    if l ~= _ then sfx(1, l, 22, 1, 13, 0) end

    local a = ch_arp[step]
    if a ~= _ then sfx(2, a, 6, 2, 7, 0) end

    local d = ch_drums[step]
    if d == 1 then sfx(3, 30, 6, 3, 14, 0)
    elseif d == 2 then sfx(4, 56, 8, 3, 14, 0)
    elseif d == 3 then sfx(5, 86, 4, 3, 6, 0)
    elseif d == 4 then sfx(6, 78, 10, 3, 11, 0)
    end

    step = step + 1
    if step > #ch_bass then
      step = loop_start
    end
  end
  tick = tick + 1
end

function TIC()
  update_music()
end