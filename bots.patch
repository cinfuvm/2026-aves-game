+function estado1v1(
+  movsCpu: MovimientoActivo[],
+  opciones: {
+    tipoCpu?: TipoPPTLS;
+    tipoJugador?: TipoPPTLS;
+    mpCpu?: number;
+    hist?: EntradaHistorial[];
